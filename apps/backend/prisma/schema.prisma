// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id          String    @id @default(uuid())
  name        String
  dateOfBirth DateTime
  gender      String
  phone       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  studies     Study[]
  brainTwins  BrainTwin[]
}

model Study {
  id               String             @id @default(uuid())
  patientId        String
  patient          Patient            @relation(fields: [patientId], references: [id])
  modality         String             // MRI, CT etc
  studyDate        DateTime
  status           String             @default("pending") // pending, processing, complete, failed
  dicomKey         String?            // MinIO object key for the raw DICOM file
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  reports          Report[]
  modelResults     ModelResult[]      // Phase 2: raw model outputs
  anomalyDetections AnomalyDetection[] // Phase 2: K-Space anomaly records
  gatingDecisions  GatingDecision[]   // Phase 2: gating decisions per inference run
}

model Report {
  id                String    @id @default(uuid())
  studyId           String
  study             Study     @relation(fields: [studyId], references: [id])
  findings          String?
  impression        String?
  patientImpression String?
  status            String    @default("draft") // draft, final
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  signOffs          RadiologistSignOff[]
}


// ---------------------------------------------------------------------------
// Phase 2 — AI Model Result Tables
// ---------------------------------------------------------------------------

/// Stores raw output from a single AI model inference run.
/// Each inference call against a study produces one ModelResult row.
model ModelResult {
  id                String            @id @default(uuid())
  studyId           String
  study             Study             @relation(fields: [studyId], references: [id])

  /// Which model produced this result (e.g. "kspace-anomaly", "image-encoder")
  modelName         String

  /// Version tag of the model (e.g. "v1.0.0", "phase2-20240618")
  modelVersion      String            @default("v1")

  /// Raw scores / output as JSON string (e.g. {"ghosting": 0.72, "wrap_around": 0.34})
  rawScores         String

  /// Overall composite confidence score [0, 1]
  confidenceScore   Float

  /// MinIO key for the reconstructed image produced by this run (nullable when gated out)
  reconstructedKey  String?

  createdAt         DateTime          @default(now())
  anomalyDetection  AnomalyDetection?
  gatingDecision    GatingDecision?
}

/// Records K-Space anomaly detection result for a study inference run.
model AnomalyDetection {
  id              String      @id @default(uuid())
  studyId         String
  study           Study       @relation(fields: [studyId], references: [id])

  /// Back-link to the ModelResult that produced this anomaly detection
  modelResultId   String      @unique
  modelResult     ModelResult @relation(fields: [modelResultId], references: [id])

  /// Individual artifact probability scores [0, 1]
  ghostingScore   Float
  wrapAroundScore Float
  zipperScore     Float

  /// SSM regression severity scores [0, 1]
  noiseSeverity   Float?
  motionSeverity  Float?
  phaseSeverity   Float?

  /// Max of the three individual scores (used for gating)
  compositeScore  Float

  /// True when compositeScore >= threshold at the time of inference
  anomalyDetected Boolean

  /// Threshold applied for this run
  threshold       Float

  createdAt       DateTime    @default(now())
}

/// Records the gating decision made after K-Space anomaly detection.
/// Controls whether the SwinTransformer Image Encoder was triggered.
model GatingDecision {
  id                     String      @id @default(uuid())
  studyId                String
  study                  Study       @relation(fields: [studyId], references: [id])

  /// Back-link to the ModelResult that produced this gating decision
  modelResultId          String      @unique
  modelResult            ModelResult @relation(fields: [modelResultId], references: [id])

  /// True when anomaly_score >= threshold (image encoder was triggered)
  imageEncoderTriggered  Boolean

  /// Confidence value at the time of gating (= compositeScore)
  confidence             Float

  /// Human-readable reason for the gating decision
  reason                 String

  createdAt              DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Phase 3 — Digital Brain Twin & Workflow Tables
// ---------------------------------------------------------------------------

model BrainTwin {
  id              String               @id @default(uuid())
  patientId       String
  patient         Patient              @relation(fields: [patientId], references: [id])
  stateVector     Bytes                // Serialized brain state s(t)
  stateTimestamp  DateTime             // When this state was computed
  version         Int                  @default(1)
  createdAt       DateTime             @default(now())
  trajectories    Trajectory[]
  simulations     TreatmentSimulation[]
}

model Trajectory {
  id              String               @id @default(uuid())
  brainTwinId     String
  brainTwin       BrainTwin            @relation(fields: [brainTwinId], references: [id])
  timepoints      Json                 // Array of {month, volumes, severity, cognitive}
  uncertaintyBand Json                 // 90% CI bounds
  createdAt       DateTime             @default(now())
}

model TreatmentSimulation {
  id              String               @id @default(uuid())
  brainTwinId     String
  brainTwin       BrainTwin            @relation(fields: [brainTwinId], references: [id])
  treatmentPlan   Json                 // {name, drugs, schedule}
  predictedOutcome Json                // {trajectory, confidence, comparison}
  createdAt       DateTime             @default(now())
}

model RadiologistSignOff {
  id              String               @id @default(uuid())
  reportId        String
  report          Report               @relation(fields: [reportId], references: [id])
  radiologistName String
  status          String               @default("pending") // pending, approved, rejected, amended
  amendments      String?              // Free text corrections
  signedAt        DateTime?
  createdAt       DateTime             @default(now())
}

model AuditLog {
  id              String               @id @default(uuid())
  userId          String
  action          String               // "viewed_report", "signed_off", "ran_simulation", etc.
  resourceType    String               // "Study", "Report", "BrainTwin", etc.
  resourceId      String
  metadata        Json?
  createdAt       DateTime             @default(now())
}